# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection Details
# Use the POOLER URL for DATABASE_URL (better performance)
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# Use the DIRECT URL for migrations (no pgbouncer)
DIRECT_URL="postgresql://user:password@host-direct/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
# In development:
NEXTAUTH_URL="http://localhost:3000"
# In production (Vercel):
# NEXTAUTH_URL="https://your-project.vercel.app"

# ─── App ──────────────────────────────────────────────────────────────────────
# In development:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# In production (Vercel):
# NEXT_PUBLIC_SITE_URL="https://blog.guvery.com"
